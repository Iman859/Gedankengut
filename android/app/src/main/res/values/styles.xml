<?xml version="1.0" encoding="utf-8"?>
<!--
  Android-Themes der App. Gedankengut ist IMMER dunkel – daher nutzen helles
  und dunkles Systemdesign dieselben dunklen Einstellungen.
-->
<resources>
    <!-- Theme während des Starts (bevor Flutter das erste Bild zeichnet). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme danach: Fensterhintergrund hinter der Flutter-Oberfläche. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/nacht</item>
    </style>
</resources>
